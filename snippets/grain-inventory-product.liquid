{% doc %}
Renders grain inventory configuration and status for product pages.
@param {object} product - Product object
@param {string} section_id - Section ID for button targeting
@example
{% render 'grain-inventory-product', product: product, section_id: section.id %}
{% enddoc %}

{%- liquid
  assign grain_enabled = false
  assign grain_group = product.metafields.custom.grain_inventory_group.value | default: product.metafields.custom.grain_inventory_group
  assign grain_recipe_fallback = blank
  assign grain_units_fallback = 0

  case product.handle
    when 'yukimochi'
      assign grain_group = grain_group | default: 'yukimochi'
      assign grain_units_fallback = 1
    when 'yukimochi-4pcs'
      assign grain_group = grain_group | default: 'yukimochi'
      assign grain_units_fallback = 4
    when 'yukimochi-9pcs'
      assign grain_group = grain_group | default: 'yukimochi'
      assign grain_units_fallback = 9
    when 'yukimochi-16pcs'
      assign grain_group = grain_group | default: 'yukimochi'
      assign grain_units_fallback = 16
    when 'dorayaki-kuro-6pcs'
      assign grain_group = grain_group | default: 'どら焼き'
      assign grain_recipe_fallback = '{"dorayaki_black":6}'
      assign grain_units_fallback = 6
    when 'dorayaki-kuro-12pcs'
      assign grain_group = grain_group | default: 'どら焼き'
      assign grain_recipe_fallback = '{"dorayaki_black":12}'
      assign grain_units_fallback = 12
    when 'dorayaki-siro-6pcs'
      assign grain_group = grain_group | default: 'どら焼き'
      assign grain_recipe_fallback = '{"dorayaki_white":6}'
      assign grain_units_fallback = 6
    when 'dorayaki-siro-12pcs'
      assign grain_group = grain_group | default: 'どら焼き'
      assign grain_recipe_fallback = '{"dorayaki_white":12}'
      assign grain_units_fallback = 12
    when 'dorayaki-2-6pcs'
      assign grain_group = grain_group | default: 'どら焼き'
      assign grain_recipe_fallback = '{"dorayaki_black":3,"dorayaki_white":3}'
      assign grain_units_fallback = 6
    when 'dorayaki-2-12'
      assign grain_group = grain_group | default: 'どら焼き'
      assign grain_recipe_fallback = '{"dorayaki_black":6,"dorayaki_white":6}'
      assign grain_units_fallback = 12
    when 'ryuhyo-kan-kibako'
      assign grain_group = grain_group | default: '流氷羹'
      assign grain_recipe_fallback = '{"ryuhyokan_item":1}'
      assign grain_units_fallback = 1
    when 'ryuhyo-kan-kamibako'
      assign grain_group = grain_group | default: '流氷羹'
      assign grain_recipe_fallback = '{"ryuhyokan_item":1}'
      assign grain_units_fallback = 1
    when 'sekketo-small'
      assign grain_group = grain_group | default: '雪景糖'
      assign grain_recipe_fallback = '{"sekketo_small":1}'
      assign grain_units_fallback = 1
    when 'sekketo-large'
      assign grain_group = grain_group | default: '雪景糖'
      assign grain_recipe_fallback = '{"sekketo_large":1}'
      assign grain_units_fallback = 1
  endcase

  if grain_group != blank
    assign grain_enabled = true
  endif

  assign pickup_date_inventory = false
  if grain_group == 'yukimochi' or grain_group == '雪餅' or grain_group == '雪もち' or grain_group == 'dorayaki' or grain_group == 'どら焼き' or grain_group == 'ryuhyokan' or grain_group == '流氷羹' or grain_group == 'sekketo' or grain_group == '雪景糖'
    assign pickup_date_inventory = true
  endif

  assign delivery_handle = product.metafields.custom.grain_stock_delivery_handle.value | default: product.metafields.custom.grain_stock_delivery_handle
  assign pickup_handle = product.metafields.custom.grain_stock_pickup_handle.value | default: product.metafields.custom.grain_stock_pickup_handle

  if delivery_handle == blank
    assign delivery_handle = product.metafields.custom.base_item_handle.value | default: product.metafields.custom.base_item_handle
  endif
-%}

{%- if grain_enabled -%}
  {%- assign delivery_stock_product = all_products[delivery_handle] -%}
  {%- assign pickup_stock_product = all_products[pickup_handle] -%}

  <script type="application/json" id="grain-inventory-variants">
    {
      {%- for variant in product.variants -%}
        {%- liquid
          # 粒数はバリエーションレベル優先、無ければ商品レベルのメタフィールドを使う。
          # この店舗では 4個入/9個入/16個入 が別商品なので値は商品レベルに入る。
          assign grain_units = variant.metafields.custom.grain_units_per_item.value | default: variant.metafields.custom.grain_units_per_item
          if grain_units == blank
            assign grain_units = product.metafields.custom.grain_units_per_item.value | default: product.metafields.custom.grain_units_per_item
          endif
          assign grain_units = grain_units | default: grain_units_fallback
          assign grain_components = variant.metafields.custom.grain_inventory_components.value
          if grain_components == blank
            assign grain_components = product.metafields.custom.grain_inventory_components.value
          endif
        -%}
        "{{ variant.id }}": {
          "group": {{ grain_group | json }},
          "unitsPerItem": {{ grain_units | json }},
          "pickupDateInventory": {{ pickup_date_inventory | json }},
          "components": {% if grain_components != blank %}{{ grain_components | json }}{% elsif grain_recipe_fallback != blank %}{{ grain_recipe_fallback }}{% else %}{}{% endif %},
          "deliveryStock": {
            "handle": {{ delivery_handle | json }},
            "quantity": {% if delivery_stock_product %}{{ delivery_stock_product.selected_or_first_available_variant.inventory_quantity | default: 0 }}{% else %}0{% endif %}
          },
          "pickupStock": {
            "handle": {{ pickup_handle | json }},
            "quantity": {% if pickup_stock_product %}{{ pickup_stock_product.selected_or_first_available_variant.inventory_quantity | default: 0 }}{% else %}0{% endif %}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var variantsEl = document.getElementById('grain-inventory-variants');
      if (!variantsEl || !window.GrainInventory) return;
      window.GrainInventory.init({
        enabled: true,
        sectionId: {{ section_id | json }},
        variants: JSON.parse(variantsEl.textContent)
      });
    });
  </script>

{%- endif -%}

{% doc %}
Validates grain inventory for cart line items.
@example
{% render 'grain-inventory-cart' %}
{% enddoc %}

{%- assign has_grain_items = false -%}
{%- for item in cart.items -%}
  {%- assign grain_prop = item.properties._grain_inventory_enabled -%}
  {%- if grain_prop == 'true' -%}
    {%- assign has_grain_items = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if has_grain_items -%}
  <div class="grain-inventory-cart-notice" id="grainInventoryCartNotice" hidden></div>

  <script type="application/json" id="grain-inventory-cart-data">
    [
      {%- assign first_grain_item = true -%}
      {%- for item in cart.items -%}
        {%- if item.properties._grain_inventory_enabled == 'true' -%}
          {%- unless first_grain_item -%},{%- endunless -%}
          {
            "key": {{ item.key | json }},
            "group": {{ item.properties._grain_inventory_group | json }},
            "method": {{ item.properties._grain_stock_method | default: 'delivery' | json }},
            "shippingSlotId": {{ item.properties._grain_shipping_slot_id | json }},
            "shippingDate": {{ item.properties._grain_shipping_date | json }},
            "deliveryDate": {{ item.properties._grain_delivery_date | json }},
            "pickupSlotId": {{ item.properties._grain_pickup_slot_id | json }},
            "pickupDate": {{ item.properties._grain_pickup_date | json }},
            "unitsPerItem": {{ item.properties._grain_units_per_item | default: 0 }},
            "componentUnits": {{ item.properties._grain_component_units | json }},
            "quantity": {{ item.quantity }}
          }
          {%- assign first_grain_item = false -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>

  <script>
    (function() {
      var dataEl = document.getElementById('grain-inventory-cart-data');
      var noticeEl = document.getElementById('grainInventoryCartNotice');
      if (!dataEl || !noticeEl) return;

      var parseComponents = function(value) {
        if (!value) return {};
        if (typeof value === 'string') {
          try { value = JSON.parse(value); } catch (_) { return {}; }
        }
        return value && typeof value === 'object' && !Array.isArray(value) ? value : {};
      };
      var items = JSON.parse(dataEl.textContent || '[]').filter(function(item) {
        return item.group && item.method
          && (parseInt(item.unitsPerItem, 10) > 0 || Object.keys(parseComponents(item.componentUnits)).length)
          && item.quantity > 0;
      });
      var groupTotals = {};
      if (!items.length) return;

      items.forEach(function(item) {
        var key = item.group + ':' + item.method + ':' + (item.shippingSlotId || item.pickupSlotId || 'legacy');
        if (!groupTotals[key]) {
          groupTotals[key] = {
            group: item.group,
            method: item.method,
            shippingSlotId: item.shippingSlotId,
            shippingDate: item.shippingDate,
            deliveryDate: item.deliveryDate,
            pickupSlotId: item.pickupSlotId,
            pickupDate: item.pickupDate,
            required: 0,
            componentUnits: {}
          };
        }
        groupTotals[key].required += (parseInt(item.unitsPerItem, 10) || 0) * item.quantity;
        Object.entries(parseComponents(item.componentUnits)).forEach(function(entry) {
          var componentId = entry[0];
          var units = parseInt(entry[1], 10) || 0;
          groupTotals[key].componentUnits[componentId] = (groupTotals[key].componentUnits[componentId] || 0) + units * item.quantity;
        });
      });

      fetch('/apps/mochi/grain-stock/check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          items: Object.values(groupTotals).map(function(g) {
            return {
              groupName: g.group,
              method: g.method,
              shippingSlotId: g.shippingSlotId,
              shippingDate: g.shippingDate,
              deliveryDate: g.deliveryDate,
              pickupSlotId: g.pickupSlotId,
              pickupDate: g.pickupDate,
              unitsPerItem: g.required,
              quantity: 1,
              componentUnits: g.componentUnits
            };
          })
        })
      }).then(function(res) {
        if (!res.ok) throw new Error('grain stock check failed');
        return res.json();
      }).then(function(result) {
        var checkoutBtn = document.getElementById('checkout') || document.querySelector('.cart__checkout-button');
        if (result.allAvailable === false) {
          // どの受取方法が何粒不足しているかを明示する（汎用文言だと別商品のせいと誤解されるため）
          var labelOf = function(m) { return m === 'pickup' ? '店頭受け取り' : '配送'; };
          var shortages = (result.results || []).filter(function(r) { return r.available === false; });
          var detail = shortages.map(function(r) {
            if (r.reason === 'mixed_shipping_slots') return '異なる発送日の商品がカートに入っています。同じ発送日に揃えてください';
            if (r.reason === 'mixed_pickup_slots') return '異なる受取日の商品がカートに入っています。同じ受取日に揃えてください';
            if (r.reason === 'slot_closed') return '選択した発送分は受付を終了しました。商品ページで別のお届け日を選び直してください';
            if (r.reason === 'slot_not_found' || r.reason === 'delivery_date_out_of_range') return '選択したお届け日を確認できません。商品ページで選び直してください';
            if (r.reason === 'pickup_slot_closed') return '選択した受取日は受付を終了しました。商品ページで別の受取日を選び直してください';
            if (r.reason === 'pickup_slot_not_found' || r.reason === 'pickup_date_mismatch') return '選択した受取日を確認できません。商品ページで選び直してください';
            if (r.components && r.components.length) {
              return labelOf(r.method) + 'の在庫が不足しています（' + r.components
                .filter(function(component) { return component.available === false; })
                .map(function(component) { return component.name; })
                .join('、') + '）';
            }
            return labelOf(r.method) + 'の商品在庫が不足しています';
          }).join(' / ');
          noticeEl.hidden = false;
          noticeEl.className = 'grain-inventory-cart-notice grain-inventory-cart-notice--error';
          noticeEl.textContent = (detail || '粒単位の在庫が不足している商品があります') + '。数量を調整してください。';
          if (checkoutBtn) checkoutBtn.setAttribute('disabled', 'disabled');
        } else {
          // 在庫が足りている場合は通知を消し、checkout を再有効化
          noticeEl.hidden = true;
          if (checkoutBtn) checkoutBtn.removeAttribute('disabled');
        }
      }).catch(function() {
        // Development previews may not be able to reach the app proxy. Do not block checkout on transport errors.
      });
    })();
  </script>

  <style>
    .grain-inventory-cart-notice {
      margin: 16px 0;
      padding: 12px 16px;
      border-radius: 4px;
      font-size: 14px;
    }
    .grain-inventory-cart-notice--error {
      background: #ffebee;
      color: #c62828;
      border-left: 4px solid #f44336;
    }
  </style>
{%- endif -%}
